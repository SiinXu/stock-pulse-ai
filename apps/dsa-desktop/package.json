{
  "name": "stockpulse-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "prepare:ollama": "node ../../scripts/prepare-embedded-ollama.js",
    "prebuild": "npm run prepare:ollama",
    "build": "electron-builder",
    "build:electron": "electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.15.30",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "eslint": "9.39.2",
    "globals": "16.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "app-builder-lib": {
      "tar": "7.5.22"
    }
  },
  "build": {
    "appId": "com.daily-stock-analysis.desktop",
    "productName": "StockPulse",
    "protocols": [
      {
        "name": "StockPulse",
        "schemes": [
          "stockpulse"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPackMacos.js",
    "files": [
      "main.js",
      "backend-runtime.js",
      "desktop-env.js",
      "local-model-catalog.js",
      "assistant-preload.js",
      "model-pack.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../../src/llm/local_model_catalog.json",
        "to": "local-model-catalog.json"
      },
      {
        "from": "../../dist/backend/stock_analysis",
        "to": "backend/stock_analysis"
      },
      {
        "from": "../../docs/assets/dsa_vi/lightlogo.iconset/icon_32x32.png",
        "to": "assistant-tray.png"
      },
      {
        "from": "vendor/ollama",
        "to": "ollama"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES",
        "to": "THIRD_PARTY_NOTICES"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "stockpulse-windows-installer-v${version}.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "SiinXu",
          "repo": "stock-pulse-ai"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "include": "installer.nsh"
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "target": "dmg"
    }
  }
}
