{
  "version": 1,
  "description": "Gzip size budgets for production Web build artifacts under static/. Initial baseline = measured gzip size * 1.10 (ceil). Tighten deliberately in follow-up tasks; do not raise budgets to hide regressions without justification.",
  "outDir": "../../static",
  "gzipLevel": 9,
  "measuredAt": "2026-08-10",
  "baselineNote": "Rebaselined AlertsWorkspace after PR #909, PlaygroundRenderPage after code-splitting plus the notification inbox scenario, and only locale chunks enlarged by genuine Notifications hub and inbox translations; other measuredGzipBytes still come from the 2026-08-08 initial baseline.",
  "defaults": {
    "jsMaxGzipBytes": 13436,
    "cssMaxGzipBytes": 28791
  },
  "rules": [
    {
      "id": "IntelligenceSourcesPanel",
      "match": "assets/IntelligenceSourcesPanel-*.js",
      "maxGzipBytes": 206424,
      "measuredGzipBytes": 187658
    },
    {
      "id": "js-entry",
      "match": "assets/index-*.js",
      "maxGzipBytes": 177591,
      "measuredGzipBytes": 161446
    },
    {
      "id": "locale-ja",
      "match": "assets/ja-*.js",
      "maxGzipBytes": 131610,
      "measuredGzipBytes": 131410,
      "note": "Tight rebaseline for the Notifications hub translations; retains 200 bytes of headroom."
    },
    {
