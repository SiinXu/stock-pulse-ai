{# Shared macros for report templates #}

{# Decision Card (Issue #861 Phase 1): presentation-only assembly from existing
   dashboard/result fields. Missing fields are omitted (no empty rows). Original
   sections remain below in full templates for backward compatibility. #}
{% macro decision_card(e, compact=false) -%}
{%- set result = e.result -%}
{%- set dashboard = e.dashboard_view if e.dashboard_view is defined and e.dashboard_view else (result.dashboard if result.dashboard else {}) -%}
{%- set core = dashboard.get('core_conclusion') or {} -%}
{%- set intel = dashboard.get('intelligence') or {} -%}
{%- set battle = dashboard.get('battle_plan') or {} -%}
{%- set phase_decision = dashboard.get('phase_decision') or {} -%}
{%- set sniper = battle.get('sniper_points') or {} -%}
{%- set pos_advice = core.get('position_advice') or {} -%}
{%- set one_sentence = core.get('one_sentence') or result.analysis_summary or '' -%}
{%- set confidence_level = (result.confidence_level or '')|string|trim -%}
{%- set confidence_reason = phase_decision.get('confidence_reason') or '' -%}
{%- set watch_conditions = phase_decision.get('watch_conditions') or [] -%}
{%- set risk_alerts = intel.get('risk_alerts') or [] -%}
{%- set risk_warning = result.risk_warning or '' -%}
{%- set risk_manager = result.risk_gate_result if result.risk_gate_result else {} -%}
{%- set time_sensitivity = core.get('time_sensitivity') or '' -%}
{%- set stop_loss = sniper.get('stop_loss') if sniper else none -%}
{%- set take_profit = sniper.get('take_profit') if sniper else none -%}
{%- set immediate_action = phase_decision.get('immediate_action') or '' -%}
{#- Brief push budget (ReportType.BRIEF / Pushover max_length=1024):
    1 primary line per stock (name + signal + score + one-sentence, parity with
    origin/main one-liner) + at most 1 supplementary line. Supplementary packs
    at most one risk and one watch condition (hard char caps). Stop/take levels
    stay on wechat/markdown cards only so a 10-stock brief fits one Pushover
    message. Do not emit the 5-line wechat compact form. -#}
{%- if compact == 'brief' -%}
**{{ e.stock_name }}({{ result.code }})** 🃏{{ e.signal_emoji }} {{ e.signal_text }} | {{ labels.score_label }} {{ result.sentiment_score }}{% if one_sentence %} | {{ one_sentence[:60] }}{{ '…' if one_sentence|length > 60 else '' }}{% endif %}{% if confidence_level %} · {{ labels.strategy_confidence_label }}: {{ confidence_level }}{% endif %}
{%- if risk_manager and risk_manager.get('schema_version') == 'risk-manager-result/v1' %}
· 🛡️ {{ labels.risk_verdict_label }}: {{ risk_manager.get('verdict') }} · {{ risk_manager.get('original_action') }}→{{ risk_manager.get('final_action') }}
{%- endif %}
{%- if risk_alerts or risk_warning or watch_conditions %}
· {% if risk_alerts %}{{ labels.risk_alerts_label }}: {{ (risk_alerts[0]|string)[:24] }}{{ '…' if (risk_alerts[0]|string)|length > 24 else '' }}{% elif risk_warning %}{{ labels.risk_warning_label }}: {{ (risk_warning|string)[:24] }}{{ '…' if (risk_warning|string)|length > 24 else '' }}{% endif %}{% if (risk_alerts or risk_warning) and watch_conditions %} | {% endif %}{% if watch_conditions %}{{ labels.watch_conditions_label }}: {{ (watch_conditions[0]|string)[:24] }}{{ '…' if (watch_conditions[0]|string)|length > 24 else '' }}{% endif %}
{%- endif %}
{%- elif compact -%}
**🃏 {{ e.signal_emoji }} {{ e.signal_text }} | {{ labels.score_label }} {{ result.sentiment_score }}**{% if one_sentence %} · {{ one_sentence[:50] }}{{ '…' if one_sentence|length > 50 else '' }}{% endif %}{% if e.localized_trend_prediction %} · {{ labels.trend_label }}: {{ e.localized_trend_prediction }}{% endif %}{% if confidence_level %} · {{ labels.strategy_confidence_label }}: {{ confidence_level }}{% endif %}
{%- if risk_manager and risk_manager.get('schema_version') == 'risk-manager-result/v1' %}
· 🛡️ {{ labels.risk_verdict_label }}: {{ risk_manager.get('verdict') }} · {{ risk_manager.get('original_action') }}→{{ risk_manager.get('final_action') }}
{%- endif %}
{%- if risk_alerts %}
· {{ labels.risk_alerts_label }}: {% for r in risk_alerts[:2] %}{{ (r|string)[:40] }}{{ '…' if (r|string)|length > 40 else '' }}{{ '; ' if not loop.last else '' }}{% endfor %}
{%- elif risk_warning %}
· {{ labels.risk_warning_label }}: {{ (risk_warning|string)[:40] }}{{ '…' if (risk_warning|string)|length > 40 else '' }}
{%- endif %}
{%- if watch_conditions %}
· {{ labels.watch_conditions_label }}: {% for c in watch_conditions[:2] %}{{ (c|string)[:40] }}{{ '…' if (c|string)|length > 40 else '' }}{{ '; ' if not loop.last else '' }}{% endfor %}
{%- endif %}
{%- if stop_loss or take_profit %}
· {% if stop_loss %}{{ labels.stop_loss_label }}: {{ clean_sniper(stop_loss) }}{% endif %}{% if stop_loss and take_profit %} | {% endif %}{% if take_profit %}{{ labels.take_profit_label }}: {{ clean_sniper(take_profit) }}{% endif %}
{%- endif %}
{%- else -%}
### 🃏 {{ e.signal_emoji }} **{{ e.signal_text }}** | {{ labels.score_label }} {{ result.sentiment_score }}
{% if risk_manager and risk_manager.get('schema_version') == 'risk-manager-result/v1' %}- **🛡️ {{ labels.risk_manager_heading }}**: {{ labels.risk_verdict_label }} `{{ risk_manager.get('verdict') }}` · {{ risk_manager.get('original_action') }} → **{{ risk_manager.get('final_action') }}** · {{ labels.risk_profile_label }} `{{ risk_manager.get('profile') }}`{% if risk_manager.get('authorized_bypass_id') %} · approval `{{ risk_manager.get('authorized_bypass_id') }}`{% endif %}
{% endif -%}
{% if one_sentence %}- **{{ labels.one_sentence_label }}**: {{ one_sentence }}
{% endif -%}
{% if e.localized_trend_prediction %}- **{{ labels.trend_label }}**: {{ e.localized_trend_prediction }}
{% endif -%}
{% if confidence_level %}- **{{ labels.strategy_confidence_label }}**: {{ confidence_level }}
{% endif -%}
{% if confidence_reason %}- **{{ labels.confidence_reason_label }}**: {{ confidence_reason }}
{% endif -%}
{% if immediate_action %}- **{{ labels.immediate_action_label }}**: {{ immediate_action }}
{% endif -%}
{% if time_sensitivity %}- **{{ labels.time_sensitivity_label }}**: {{ time_sensitivity }}
{% endif -%}
{% if pos_advice.get('no_position') or pos_advice.get('has_position') %}- **{{ labels.position_advice_heading }}**: {% if pos_advice.get('no_position') %}{{ labels.no_position_label }}: {{ pos_advice.get('no_position') }}{% endif %}{% if pos_advice.get('no_position') and pos_advice.get('has_position') %} · {% endif %}{% if pos_advice.get('has_position') %}{{ labels.has_position_label }}: {{ pos_advice.get('has_position') }}{% endif %}
{% endif -%}
{% if risk_alerts %}- **{{ labels.risk_alerts_label }}**:
{% for r in risk_alerts[:3] %}  - {{ r }}
{% endfor -%}
{% elif risk_warning %}- **{{ labels.risk_warning_label }}**: {{ risk_warning }}
{% endif -%}
{% if watch_conditions %}- **{{ labels.watch_conditions_label }}**:
{% for c in watch_conditions[:3] %}  - {{ c }}
{% endfor -%}
{% endif -%}
{% if stop_loss or take_profit %}- **{{ labels.action_points_heading }}**: {% if stop_loss %}{{ labels.stop_loss_label }} {{ clean_sniper(stop_loss) }}{% endif %}{% if stop_loss and take_profit %} · {% endif %}{% if take_profit %}{{ labels.take_profit_label }} {{ clean_sniper(take_profit) }}{% endif %}
{% endif -%}
{%- endif %}
{%- endmacro %}

{% macro report_strata_section(strata, compact=false) -%}
{% if strata %}
{% if not compact %}
### 🧾 {{ labels.report_strata_heading }}

#### 1. {{ labels.verified_facts_heading }}
{% if strata.verified_facts %}
{% for fact in strata.verified_facts %}
- {{ fact.statement }}{% if fact.source_id %} （{{ labels.fact_source_label }}: `{{ fact.source_id }}`）{% else %} （{{ labels.fact_source_unknown_label }}）{% endif %}{% if fact.as_of %} · {{ labels.fact_as_of_label }}: {{ fact.as_of }}{% else %} · {{ labels.fact_as_of_unknown_label }}{% endif %}
{% endfor %}
{% else %}
- —
{% endif %}

#### 2. {{ labels.missing_or_conflicts_heading }}
{% if strata.missing_or_conflicts %}
{% for gap in strata.missing_or_conflicts %}
- [{% if gap.kind == 'conflict' %}{{ labels.gap_kind_conflict_label }}{% else %}{{ labels.gap_kind_missing_label }}{% endif %}] {{ gap.description }}{% if gap.source_ids %}（{{ gap.source_ids|join(', ') }}）{% endif %}
{% endfor %}
{% else %}
- —
{% endif %}

#### 3. {{ labels.model_inference_heading }}
{% if strata.model_inference %}
{% for item in strata.model_inference %}
- {{ item }}
{% endfor %}
{% else %}
- —
{% endif %}

#### 4. {{ labels.risks_counter_evidence_heading }}
{% if strata.risks_counter_evidence %}
{% for item in strata.risks_counter_evidence %}
- {{ item }}
{% endfor %}
{% else %}
- —
{% endif %}

#### 5. {{ labels.framework_alignment_heading }}
{% set fa = strata.framework_alignment or {} %}
- {{ fa.summary or labels.framework_not_configured_label }}{% if fa.status %}（{{ fa.status }}）{% endif %}

{% else %}
**🧾 {{ labels.report_strata_heading }}**
{% if strata.verified_facts %}
· {{ labels.verified_facts_heading }}: {% for fact in strata.verified_facts[:2] %}{{ fact.statement[:40] }}{{ '…' if fact.statement|length > 40 else '' }}{{ '; ' if not loop.last else '' }}{% endfor %}
{% endif %}
{% if strata.model_inference %}
· {{ labels.model_inference_heading }}: {{ strata.model_inference[0][:50] }}{{ '…' if strata.model_inference[0]|length > 50 else '' }}
{% endif %}
{% set fa = strata.framework_alignment or {} %}
· {{ labels.framework_alignment_heading }}: {{ fa.summary or labels.framework_not_configured_label }}
{% endif %}
{% endif %}
{%- endmacro %}

{% macro report_disclaimer_line() -%}
*{{ labels.not_investment_advice }}*
{%- endmacro %}

