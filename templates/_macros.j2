{# Shared macros for report templates #}

{# Decision Card (#861): presentation-only from renderer-built e.decision_card. #}
{% macro decision_card(e, compact=false) -%}
{%- set card = e.decision_card or {} -%}
{%- if compact -%}
**🃏 {{ card.signal_emoji or e.signal_emoji }} {{ card.signal_text or e.signal_text }} | {{ labels.score_label }} {{ card.score if card.score is not none else e.result.sentiment_score }}**{% if card.one_sentence %} · {{ card.one_sentence }}{% endif %}{% if card.trend %} · {{ labels.trend_label }}: {{ card.trend }}{% endif %}{% if card.confidence_level %} · {{ labels.strategy_confidence_label }}: {{ card.confidence_level }}{% endif %}
{%- if card.risks %}
· {{ labels.risk_alerts_label }}: {% for r in card.risks %}{{ r }}{{ '; ' if not loop.last else '' }}{% endfor %}
{%- endif %}
{%- if card.triggers %}
· {{ labels.watch_conditions_label }}: {% for c in card.triggers %}{{ c }}{{ '; ' if not loop.last else '' }}{% endfor %}
{%- endif %}
{%- if card.stop_loss or card.take_profit %}
· {% if card.stop_loss %}{{ labels.stop_loss_label }}: {{ clean_sniper(card.stop_loss) }}{% endif %}{% if card.stop_loss and card.take_profit %} | {% endif %}{% if card.take_profit %}{{ labels.take_profit_label }}: {{ clean_sniper(card.take_profit) }}{% endif %}
{%- endif %}
{%- else -%}
### 🃏 {{ card.signal_emoji or e.signal_emoji }} **{{ card.signal_text or e.signal_text }}** | {{ labels.score_label }} {{ card.score if card.score is not none else e.result.sentiment_score }}
{% if card.one_sentence %}- **{{ labels.one_sentence_label }}**: {{ card.one_sentence }}
{% endif -%}
{% if card.trend %}- **{{ labels.trend_label }}**: {{ card.trend }}
{% endif -%}
{% if card.confidence_level %}- **{{ labels.strategy_confidence_label }}**: {{ card.confidence_level }}
{% endif -%}
{% if card.confidence_reason %}- **{{ labels.confidence_reason_label }}**: {{ card.confidence_reason }}
{% endif -%}
{% if card.immediate_action %}- **{{ labels.immediate_action_label }}**: {{ card.immediate_action }}
{% endif -%}
{% if card.time_sensitivity %}- **{{ labels.time_sensitivity_label }}**: {{ card.time_sensitivity }}
{% endif -%}
{% if card.position_no or card.position_has %}- **{{ labels.position_advice_heading }}**: {% if card.position_no %}{{ labels.no_position_label }}: {{ card.position_no }}{% endif %}{% if card.position_no and card.position_has %} · {% endif %}{% if card.position_has %}{{ labels.has_position_label }}: {{ card.position_has }}{% endif %}
{% endif -%}
{% if card.risks %}- **{{ labels.risk_alerts_label }}**:
{% for r in card.risks %}  - {{ r }}
{% endfor -%}
{% endif -%}
{% if card.triggers %}- **{{ labels.watch_conditions_label }}**:
{% for c in card.triggers %}  - {{ c }}
{% endfor -%}
{% endif -%}
{% if card.stop_loss or card.take_profit %}- **{{ labels.action_points_heading }}**: {% if card.stop_loss %}{{ labels.stop_loss_label }} {{ clean_sniper(card.stop_loss) }}{% endif %}{% if card.stop_loss and card.take_profit %} · {% endif %}{% if card.take_profit %}{{ labels.take_profit_label }} {{ clean_sniper(card.take_profit) }}{% endif %}
{% endif -%}
{%- endif %}
{%- endmacro %}

{% macro report_strata_section(strata, compact=false) -%}
{% if strata %}
{% if not compact %}
### 🧾 {{ labels.report_strata_heading }}

#### 1. {{ labels.verified_facts_heading }}
{% if strata.verified_facts %}
{% for fact in strata.verified_facts %}
- {{ fact.statement }}{% if fact.source_id %} （{{ labels.fact_source_label }}: `{{ fact.source_id }}`）{% else %} （{{ labels.fact_source_unknown_label }}）{% endif %}{% if fact.as_of %} · {{ labels.fact_as_of_label }}: {{ fact.as_of }}{% else %} · {{ labels.fact_as_of_unknown_label }}{% endif %}
{% endfor %}
{% else %}
- —
{% endif %}

#### 2. {{ labels.missing_or_conflicts_heading }}
{% if strata.missing_or_conflicts %}
{% for gap in strata.missing_or_conflicts %}
- [{% if gap.kind == 'conflict' %}{{ labels.gap_kind_conflict_label }}{% else %}{{ labels.gap_kind_missing_label }}{% endif %}] {{ gap.description }}{% if gap.source_ids %}（{{ gap.source_ids|join(', ') }}）{% endif %}
{% endfor %}
{% else %}
- —
{% endif %}

#### 3. {{ labels.model_inference_heading }}
{% if strata.model_inference %}
{% for item in strata.model_inference %}
- {{ item }}
{% endfor %}
{% else %}
- —
{% endif %}

#### 4. {{ labels.risks_counter_evidence_heading }}
{% if strata.risks_counter_evidence %}
{% for item in strata.risks_counter_evidence %}
- {{ item }}
{% endfor %}
{% else %}
- —
{% endif %}

#### 5. {{ labels.framework_alignment_heading }}
{% set fa = strata.framework_alignment or {} %}
- {{ fa.summary or labels.framework_not_configured_label }}{% if fa.status %}（{{ fa.status }}）{% endif %}

{% else %}
**🧾 {{ labels.report_strata_heading }}**
{% if strata.verified_facts %}
· {{ labels.verified_facts_heading }}: {% for fact in strata.verified_facts[:2] %}{{ fact.statement[:40] }}{{ '…' if fact.statement|length > 40 else '' }}{{ '; ' if not loop.last else '' }}{% endfor %}
{% endif %}
{% if strata.model_inference %}
· {{ labels.model_inference_heading }}: {{ strata.model_inference[0][:50] }}{{ '…' if strata.model_inference[0]|length > 50 else '' }}
{% endif %}
{% set fa = strata.framework_alignment or {} %}
· {{ labels.framework_alignment_heading }}: {{ fa.summary or labels.framework_not_configured_label }}
{% endif %}
{% endif %}
{%- endmacro %}

{% macro report_disclaimer_line() -%}
